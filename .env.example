# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore and must NEVER be committed or screenshotted.
# ---------------------------------------------------------------------------

# local | production
APP_ENV=local
APP_NAME="Inventory Management System"
APP_TZ=Asia/Kuala_Lumpur
APP_CURRENCY=RM

# --- Local database (XAMPP / MySQL) ----------------------------------------
# Do NOT use the XAMPP default "root" account with a blank password.
# tools/setup_local.ps1 creates the dedicated account below for you.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=inventory_app
DB_PASS=change_this_password

# --- Cloud database ---------------------------------------------------------
# On Render this is injected automatically from the managed PostgreSQL
# instance, so leave it blank locally.
DATABASE_URL=

# --- One-time installer token ----------------------------------------------
# Required by /install.php. Generate a long random string; the installer is
# disabled whenever this value is empty.
INSTALL_TOKEN=
